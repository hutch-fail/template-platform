# Copy to .env (safe to sync to GitHub Actions environment secrets).
#
#   cp .env.example .env
#   make doctor

# --- R2 remote state (see docs/bootstrap-state.md) ---
CLOUDFLARE_ACCOUNT_ID=
TF_BACKEND_ENDPOINT=
TF_BACKEND_BUCKET=platform-state
TF_BACKEND_KEY=template/terraform.tfstate
TF_BACKEND_REGION=auto

# Bucket-scoped R2 API token (Object Read & Write on platform-state only)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional overrides (defaults are fine)
# TF_DIR=terraform
# TOFU_BIN=tofu
# GITHUB_OWNER=hutch-fail
# GITHUB_REPO=template-platform
