--- a/baseline/.cursor/rules/wrap-prior-art.mdc
+++ b/baseline/.cursor/rules/wrap-prior-art.mdc
@@ -0,0 +1,21 @@
+---
+description: >-
+  Wrap and pin existing tools; do not reimplement prior art when an upstream
+  exists. Adapters use documented extension points, not forks of source.
+alwaysApply: true
+---
+
+# Wrap prior art
+
+When a named upstream tool already implements the mechanism, pin an unmodified
+copy and put org/repo/git/CI behavior in a wrapper. Do not rewrite the
+upstream in-tree.
+
+## Do
+
+- Record the pin next to the vendored file.
+- Extend through the hook the tool already ships.
+
+## Do not
+
+- Edit vendored third-party source as if it were ours.
--- a/baseline/install-host-adapters.sh
+++ b/baseline/install-host-adapters.sh
@@ -3,7 +3,7 @@
 set -euo pipefail
 PROJECT_ROOT="$(pwd)"
 EVALS_DIR="${PROJECT_ROOT}/evals"
-for rule in meta-dev.mdc goal-spec.mdc live-verify.mdc; do
+for rule in meta-dev.mdc goal-spec.mdc live-verify.mdc wrap-prior-art.mdc; do
   [[ -f "${EVALS_DIR}/.cursor/rules/${rule}" ]] || true
 done
