# Keep Cursor project skills/rules trackable despite global .cursor ignores
!.cursor/
.cursor/*
!.cursor/skills/
!.cursor/skills/**
!.cursor/rules/
!.cursor/rules/**

# Same for .agents skill adapters
!.agents/
.agents/*
!.agents/skills/
!.agents/skills/**

# Local secrets (never commit). Keep .env.example tracked.
.env
.env.*
!.env.example

# Eval harness run artefacts (never commit)
runs/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/.venv-llm/
