# Copy to .env (never commit):
#   cp .env.example .env
# Then replace REPLACE_ME values. Prefer:
#   make optmem/doctor
#   make optmem/reconcile
# Or load manually: set -a && source .env && set +a
#
# Same names are GitHub Actions secrets for:
#   - eval-ci.yml          (meta Tier-3 LiteLLM pack rubric)
#   - optmem-reconcile.yml (native memo nap after folding shards into .optmem/main)
#
# Opt-in: leave EVAL_LLM_MODEL empty to skip LLM paths (CI stays green;
# OptMem reconcile still folds shards, but leaves nap pending until a model+key exist).

# ---------------------------------------------------------------------------
# LiteLLM OpenAI-compatible API — pack quality Tier 3 + OptMem reconcile nap
# Use litellm-api.hutch.fail (Meter virtual key only; Cloudflare Access bypassed).
# Do NOT use litellm.hutch.fail here — that hostname is the Admin UI behind Access.
# ---------------------------------------------------------------------------
EVAL_LLM_API_KEY=sk-litellm-REPLACE_ME
EVAL_LLM_BASE_URL=https://litellm-api.hutch.fail/v1
EVAL_LLM_MODEL=gpt-4o-mini

# Fallbacks accepted by harness / repo-memo when EVAL_LLM_* is unset:
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# OPENAI_BASE_URL=

# ---------------------------------------------------------------------------
# TypeSafe (meta Tier 2 / Jev) — optional locally; CI uses secrets.TYPESAFE_API_KEY
# Prefer monorepo-root ../.env when working from the hutch-fail workspace.
# ---------------------------------------------------------------------------
# TYPESAFE_API_KEY=
